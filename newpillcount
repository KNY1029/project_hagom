+  /// A completed dose consumes one tracked pill.
+  void _decrementPillCount(MedicationItem med) {
+    final count = med.remainingPillCount;
+    if (count != null) {
+      med.remainingPillCount = (count - 1).clamp(0, 999999);
+    }
+  }
+
+  /// Undoing a dose restores one pill. Counts can exceed the original amount
+  /// if the user has recorded a refill in Settings.
+  void _restorePillCount(MedicationItem med) {
+    final count = med.remainingPillCount;
+    if (count != null) {
+      med.remainingPillCount = (count + 1).clamp(0, 999999);
+    }
+  }
+
+  /// Set or disable pill tracking. When enabling or changing the initial
+  /// amount, reset the remaining count to the new initial amount.
+  void setMedicationPillCount({
+    required String medId,
+    required int initialCount,
+    required bool enabled,
+    bool resetRemaining = true,
+  }) {
+    final med = _medications.firstWhere((m) => m.id == medId);
+    if (!enabled) {
+      med.initialPillCount = null;
+      med.remainingPillCount = null;
+    } else {
+      final count = initialCount.clamp(0, 999999);
+      med.initialPillCount = count;
+      if (resetRemaining || med.remainingPillCount == null) {
+        med.remainingPillCount = count;
+      }
+    }
+    notifyListeners();
+  }
+
+  /// Adjust the current inventory, for example after a refill.
+  void setRemainingPillCount(String medId, int count) {
+    final med = _medications.firstWhere((m) => m.id == medId);
+    if (med.initialPillCount == null) return;
+    med.remainingPillCount = count.clamp(0, 999999);
+    notifyListeners();
+  }
