<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_month_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hagom_widget_bg"
    android:orientation="vertical"
    android:padding="13dp">

    <!-- 1) 상단 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_month_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2026년 11월 기록 달력"
            android:textColor="#1F2937"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="하곰이"
            android:scaleType="fitCenter"
            android:src="@drawable/hagomi_mascot" />
    </LinearLayout>

    <!-- 2) 요일 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="일" android:textColor="#EF4444" android:textSize="10.5sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="월" android:textColor="#6B7280" android:textSize="10.5sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="화" android:textColor="#6B7280" android:textSize="10.5sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="수" android:textColor="#6B7280" android:textSize="10.5sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="목" android:textColor="#6B7280" android:textSize="10.5sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="금" android:textColor="#6B7280" android:textSize="10.5sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="토" android:textColor="#6B7280" android:textSize="10.5sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="#E5E7EB" />

    <!-- 3) 달력 그리드 영역: 고정 높이(세로로 늘려도 달력 칸이 과하게 벌어지지 않고 아래 요약이 넓어짐) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:id="@+id/d_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="1" android:textColor="#EF4444" android:textSize="11.5sp" />
            <TextView android:id="@+id/d_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="2" android:textColor="#1F2937" android:textSize="11.5sp" />
            <TextView android:id="@+id/d_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="3" android:textColor="#1F2937" android:textSize="11.5sp" />
            <TextView android:id="@+id/d_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="4" android:textColor="#1F2937" android:textSize="11.5sp" />
            <TextView android:id="@+id/d_5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="5" android:textColor="#1F2937" android:textSize="11.5sp" />
            <TextView android:id="@+id/d_6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="6" android:textColor="#1F2937" android:textSize="11.5sp" />
            <TextView android:id="@+id/d_7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="7" android:textColor="#1F2937" android:textSize="11.5sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:id="@+id/d_8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="8" android:textColor="#EF4444" android:textSize="11.5sp" />
            <TextView android:id="@+id/d_9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="9" android:textColor="#1F2937" android:textSize="11.5sp" />
            <TextView android:id="@+id/d_10" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="10" android:textColor="#1F2937" android:textSize="11.5sp" />
            <TextView android:id="@+id/d_11" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="11" android:textColor="#1F2937" android:textSize="11.5sp" />
            <TextView android:id="@+id/d_12" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="12" android:textColor="#1F2937" android:textSize="11.5sp" />
            <TextView android:id="@+id/d_13" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="13" android:textColor="#1F2937" android:textSize="11.5sp" />
            <TextView android:id="@+id/d_14" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="14" android:textColor="#1F2937" android:textSize="11.5sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:id="@+id/d_15" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="15" android:textColor="#EF4444" android:textSize="11.5sp" />
            <TextView android:id="@+id/d_16" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="16" android:textColor="#1F2937" android:textSize="11.5sp" />
            <TextView android:id="@+id/d_17" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="17" android:textColor="#1F2937" android:textSize="11.5sp" />
            <TextView android:id="@+id/d_18" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="18" android:textColor="#1F2937" android:textSize="11.5sp" />
            <TextView android:id="@+id/d_19" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="19" android:textColor="#1F2937" android:textSize="11.5sp" />
            <TextView android:id="@+id/d_20" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="20" android:textColor="#1F2937" android:textSize="11.5sp" />
            <TextView android:id="@+id/d_21" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="21" android:textColor="#1F2937" android:textSize="11.5sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:id="@+id/d_22" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="22" android:textColor="#EF4444" android:textSize="11.5sp" />
            <TextView android:id="@+id/d_23" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="23" android:textColor="#1F2937" android:textSize="11.5sp" />
            <TextView android:id="@+id/d_24" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="24" android:textColor="#1F2937" android:textSize="11.5sp" />
            <TextView android:id="@+id/d_25" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="25" android:textColor="#1F2937" android:textSize="11.5sp" />
            <TextView android:id="@+id/d_26" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="26" android:textColor="#1F2937" android:textSize="11.5sp" />
            <TextView android:id="@+id/d_27" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="27" android:textColor="#1F2937" android:textSize="11.5sp" />
            <TextView android:id="@+id/d_28" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="28" android:textColor="#1F2937" android:textSize="11.5sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:id="@+id/d_29" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="29" android:textColor="#EF4444" android:textSize="11.5sp" />
            <TextView android:id="@+id/d_30" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="30" android:textColor="#1F2937" android:textSize="11.5sp" />
            <TextView android:id="@+id/d_31" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="" android:textColor="#1F2937" android:textSize="11.5sp" />
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <!-- 4) 하단 요약 & 상세 영역: layout_weight="1"을 부여해 세로로 늘릴수록 이 영역이 커짐 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/hagom_widget_tag_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="오늘 할일"
                android:textColor="#8B5E3C"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_month_tasks"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#1F2937"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/hagom_widget_done_bg"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:paddingVertical="5dp">

                <TextView
                    android:id="@+id/widget_month_habits"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#044E36"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/hagom_widget_tag_bg"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:paddingVertical="5dp">

                <TextView
                    android:id="@+id/widget_month_meds"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#7B61A8"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 세로로 기본보다 더 길게 늘렸을 때 추가로 펼쳐지는 오늘의 할일/복약/습관 상세 줄 -->
        <LinearLayout
            android:id="@+id/month_extra_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/month_detail_1"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:text=""
                android:textColor="#374151"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/month_detail_2"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:text=""
                android:textColor="#374151"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/month_detail_3"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:text=""
                android:textColor="#374151"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/month_detail_4"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:text=""
                android:textColor="#374151"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
