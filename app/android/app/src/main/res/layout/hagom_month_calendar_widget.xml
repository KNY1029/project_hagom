<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_month_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hagom_widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 1) 상단 헤더: 이전달(◀), 완벽한 중앙 대칭 하곰이 아이콘 + 월 제목, 다음달(▶) -->
    <LinearLayout
        android:id="@+id/widget_month_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_month_prev_btn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="◀"
            android:textColor="#7B61A8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/widget_month_header_center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_month_mascot_btn"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="하곰이의 방"
                android:scaleType="fitCenter"
                android:src="@drawable/hagom_mascot" />
            <TextView
                android:id="@+id/widget_month_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026년 11월 기록 달력"
                android:textColor="#1F2937"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_month_next_btn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="▶"
            android:textColor="#7B61A8"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2) 요일 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="일" android:textColor="#EF4444" android:textSize="10.5sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="월" android:textColor="#6B7280" android:textSize="10.5sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="화" android:textColor="#6B7280" android:textSize="10.5sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="수" android:textColor="#6B7280" android:textSize="10.5sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="목" android:textColor="#6B7280" android:textSize="10.5sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="금" android:textColor="#6B7280" android:textSize="10.5sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="토" android:textColor="#6B7280" android:textSize="10.5sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="#E5E7EB" />

    <!-- 3) 달력 그리드: 위젯 높이에 맞춰 확장하고, 같은 크기에서는 날짜 선택에 흔들리지 않음 -->
    <LinearLayout
        android:id="@+id/month_calendar_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 1주차 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:id="@+id/c_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#EF4444" android:textSize="12sp" />
            <TextView android:id="@+id/c_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#1F2937" android:textSize="12sp" />
            <TextView android:id="@+id/c_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#1F2937" android:textSize="12sp" />
            <TextView android:id="@+id/c_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#1F2937" android:textSize="12sp" />
            <TextView android:id="@+id/c_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#1F2937" android:textSize="12sp" />
            <TextView android:id="@+id/c_5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#1F2937" android:textSize="12sp" />
            <TextView android:id="@+id/c_6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#1F2937" android:textSize="12sp" />
        </LinearLayout>

        <!-- 2주차 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:id="@+id/c_7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#EF4444" android:textSize="12sp" />
            <TextView android:id="@+id/c_8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#1F2937" android:textSize="12sp" />
            <TextView android:id="@+id/c_9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#1F2937" android:textSize="12sp" />
            <TextView android:id="@+id/c_10" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#1F2937" android:textSize="12sp" />
            <TextView android:id="@+id/c_11" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#1F2937" android:textSize="12sp" />
            <TextView android:id="@+id/c_12" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#1F2937" android:textSize="12sp" />
            <TextView android:id="@+id/c_13" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#1F2937" android:textSize="12sp" />
        </LinearLayout>

        <!-- 3주차 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:id="@+id/c_14" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#EF4444" android:textSize="12sp" />
            <TextView android:id="@+id/c_15" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#1F2937" android:textSize="12sp" />
            <TextView android:id="@+id/c_16" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#1F2937" android:textSize="12sp" />
            <TextView android:id="@+id/c_17" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#1F2937" android:textSize="12sp" />
            <TextView android:id="@+id/c_18" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#1F2937" android:textSize="12sp" />
            <TextView android:id="@+id/c_19" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#1F2937" android:textSize="12sp" />
            <TextView android:id="@+id/c_20" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#1F2937" android:textSize="12sp" />
        </LinearLayout>

        <!-- 4주차 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:id="@+id/c_21" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#EF4444" android:textSize="12sp" />
            <TextView android:id="@+id/c_22" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#1F2937" android:textSize="12sp" />
            <TextView android:id="@+id/c_23" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#1F2937" android:textSize="12sp" />
            <TextView android:id="@+id/c_24" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#1F2937" android:textSize="12sp" />
            <TextView android:id="@+id/c_25" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#1F2937" android:textSize="12sp" />
            <TextView android:id="@+id/c_26" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#1F2937" android:textSize="12sp" />
            <TextView android:id="@+id/c_27" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#1F2937" android:textSize="12sp" />
        </LinearLayout>

        <!-- 5주차 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:id="@+id/c_28" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#EF4444" android:textSize="12sp" />
            <TextView android:id="@+id/c_29" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#1F2937" android:textSize="12sp" />
            <TextView android:id="@+id/c_30" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#1F2937" android:textSize="12sp" />
            <TextView android:id="@+id/c_31" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#1F2937" android:textSize="12sp" />
            <TextView android:id="@+id/c_32" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#1F2937" android:textSize="12sp" />
            <TextView android:id="@+id/c_33" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#1F2937" android:textSize="12sp" />
            <TextView android:id="@+id/c_34" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#1F2937" android:textSize="12sp" />
        </LinearLayout>

        <!-- 6주차 (5주로 끝나는 달은 GONE 처리하여 5개 주가 훨씬 큼직하게 확장!) -->
        <LinearLayout
            android:id="@+id/month_week_row_6"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:id="@+id/c_35" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#EF4444" android:textSize="12sp" />
            <TextView android:id="@+id/c_36" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#1F2937" android:textSize="12sp" />
            <TextView android:id="@+id/c_37" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#1F2937" android:textSize="12sp" />
            <TextView android:id="@+id/c_38" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#1F2937" android:textSize="12sp" />
            <TextView android:id="@+id/c_39" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#1F2937" android:textSize="12sp" />
            <TextView android:id="@+id/c_40" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#1F2937" android:textSize="12sp" />
            <TextView android:id="@+id/c_41" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#1F2937" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 4) 실제 할일 목록 (컴팩트 46dp 틀로 달력 영역에 더 넓은 공간을 양보!) -->
    <LinearLayout
        android:id="@+id/widget_month_tasks_list"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="2dp"
        android:gravity="bottom"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 하나의 연보라 카드 상자: 할일이 있는 줄 수만큼만 높이가 늘어나며 감싸줌! -->
        <LinearLayout
            android:id="@+id/month_tasks_card_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/hagom_widget_tag_bg"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp">

            <!-- 좌측 열 (gravity=bottom) -->
            <LinearLayout
                android:id="@+id/month_tasks_col_left"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView android:id="@+id/month_task_1" android:layout_width="match_parent" android:layout_height="14dp" android:ellipsize="end" android:gravity="center_vertical" android:maxLines="1" android:paddingHorizontal="2dp" android:text="" android:textColor="#374151" android:textSize="9sp" android:visibility="gone" />
                <TextView android:id="@+id/month_task_2" android:layout_width="match_parent" android:layout_height="14dp" android:ellipsize="end" android:gravity="center_vertical" android:maxLines="1" android:paddingHorizontal="2dp" android:text="" android:textColor="#374151" android:textSize="9sp" android:visibility="gone" />
                <TextView android:id="@+id/month_task_3" android:layout_width="match_parent" android:layout_height="14dp" android:ellipsize="end" android:gravity="center_vertical" android:maxLines="1" android:paddingHorizontal="2dp" android:text="" android:textColor="#374151" android:textSize="9sp" android:visibility="gone" />
            </LinearLayout>

            <!-- 우측 열 (gravity=bottom) -->
            <LinearLayout
                android:id="@+id/month_tasks_col_right"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView android:id="@+id/month_task_4" android:layout_width="match_parent" android:layout_height="14dp" android:ellipsize="end" android:gravity="center_vertical" android:maxLines="1" android:paddingHorizontal="2dp" android:text="" android:textColor="#374151" android:textSize="9sp" android:visibility="gone" />
                <TextView android:id="@+id/month_task_5" android:layout_width="match_parent" android:layout_height="14dp" android:ellipsize="end" android:gravity="center_vertical" android:maxLines="1" android:paddingHorizontal="2dp" android:text="" android:textColor="#374151" android:textSize="9sp" android:visibility="gone" />
                <TextView android:id="@+id/month_task_6" android:layout_width="match_parent" android:layout_height="14dp" android:ellipsize="end" android:gravity="center_vertical" android:maxLines="1" android:paddingHorizontal="2dp" android:text="" android:textColor="#374151" android:textSize="9sp" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 5) 선택 날짜의 할일 요약 헤더 (항상 단독 보라색 카드 배경) -->
    <LinearLayout
        android:id="@+id/widget_month_tasks_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@drawable/hagom_widget_tag_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp">
        <TextView
            android:id="@+id/widget_month_tasks_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="오늘의 할일"
            android:textColor="#7B61A8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_month_tasks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:text=""
            android:textColor="#7B61A8"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 6) 요약 배지는 항상 위젯의 맨 아래에 유지 -->
    <LinearLayout
        android:id="@+id/month_bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_month_habits_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/hagom_widget_tag_bg"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:paddingVertical="5dp">

            <TextView
                android:id="@+id/widget_month_habits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#7B61A8"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_month_meds_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/hagom_widget_tag_bg"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:paddingVertical="5dp">

            <TextView
                android:id="@+id/widget_month_meds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#7B61A8"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
