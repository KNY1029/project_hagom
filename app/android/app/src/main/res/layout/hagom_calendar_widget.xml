<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_calendar_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hagom_widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 1) 3x1 기본 행 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 좌측 정보 영역 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 상단 태그 및 진행 현황 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_calendar_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/hagom_widget_tag_bg"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="2dp"
                    android:text="오늘의 일정"
                    android:textColor="#7B61A8"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_calendar_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="오후 2:00"
                    android:textColor="#6B7280"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 일정 제목 -->
            <TextView
                android:id="@+id/widget_calendar_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="약학 실습 보고서 작성"
                android:textColor="#1F2937"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <!-- 일정 설명 -->
            <TextView
                android:id="@+id/widget_calendar_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="카테고리: 과제 및 실습"
                android:textColor="#4B5568"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 우측 체크 버튼 -->
        <LinearLayout
            android:id="@+id/widget_calendar_btn"
            android:layout_width="72dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/hagom_widget_task_btn_bg"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/widget_calendar_btn_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="체크"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2) 🌟 [세로로 늘렸을 때(3x2, 3x3) 나타나는 오늘 전체 할일 목록 확장 영역] -->
    <LinearLayout
        android:id="@+id/widget_calendar_expanded_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <!-- 구분선 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="6dp"
            android:background="#E5E7EB" />

        <!-- 할일 1 (약학 실습 보고서) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="약학 실습 보고서 작성 (오후 2:00)"
                android:textColor="#1F2937"
                android:textSize="11.5sp" />

            <TextView
                android:layout_width="54dp"
                android:layout_height="24dp"
                android:background="@drawable/hagom_widget_task_btn_bg"
                android:gravity="center"
                android:text="체크"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 할일 2 (병원 진료 및 상담) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="정신건강의학과 정기 진료 (오후 4:30)"
                android:textColor="#1F2937"
                android:textSize="11.5sp" />

            <TextView
                android:layout_width="54dp"
                android:layout_height="24dp"
                android:background="@drawable/hagom_widget_task_btn_bg"
                android:gravity="center"
                android:text="체크"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
