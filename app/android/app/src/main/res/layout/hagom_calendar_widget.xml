<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_calendar_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hagom_widget_bg"
    android:orientation="vertical"
    android:paddingHorizontal="11dp"
    android:paddingVertical="9dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_calendar_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/hagom_widget_tag_bg"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1.5dp"
                    android:text="오늘의 할일"
                    android:textColor="#7B61A8"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_calendar_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#6B7280"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_calendar_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#1F2937"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_calendar_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#4B5568"
                android:textSize="10.5sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_calendar_btn"
            android:layout_width="64dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/hagom_widget_task_btn_bg"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_calendar_btn_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="체크"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_calendar_btn_compact"
            android:layout_width="46dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/hagom_widget_task_btn_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_calendar_btn_compact_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="체크"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/calendar_expanded_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="3dp"
            android:background="#E5E7EB" />

        <LinearLayout android:id="@+id/cal_row_1" android:layout_width="match_parent" android:layout_height="26dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/cal_row_1_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="" android:textColor="#1F2937" android:textSize="11sp" />
            <TextView android:id="@+id/cal_row_1_btn" android:layout_width="44dp" android:layout_height="21dp" android:layout_marginStart="6dp" android:background="@drawable/hagom_widget_task_btn_bg" android:gravity="center" android:text="체크" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/cal_row_2" android:layout_width="match_parent" android:layout_height="26dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/cal_row_2_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="" android:textColor="#1F2937" android:textSize="11sp" />
            <TextView android:id="@+id/cal_row_2_btn" android:layout_width="44dp" android:layout_height="21dp" android:layout_marginStart="6dp" android:background="@drawable/hagom_widget_task_btn_bg" android:gravity="center" android:text="체크" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/cal_row_3" android:layout_width="match_parent" android:layout_height="26dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/cal_row_3_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="" android:textColor="#1F2937" android:textSize="11sp" />
            <TextView android:id="@+id/cal_row_3_btn" android:layout_width="44dp" android:layout_height="21dp" android:layout_marginStart="6dp" android:background="@drawable/hagom_widget_task_btn_bg" android:gravity="center" android:text="체크" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/cal_row_4" android:layout_width="match_parent" android:layout_height="26dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/cal_row_4_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="" android:textColor="#1F2937" android:textSize="11sp" />
            <TextView android:id="@+id/cal_row_4_btn" android:layout_width="44dp" android:layout_height="21dp" android:layout_marginStart="6dp" android:background="@drawable/hagom_widget_task_btn_bg" android:gravity="center" android:text="체크" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/cal_row_5" android:layout_width="match_parent" android:layout_height="26dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/cal_row_5_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="" android:textColor="#1F2937" android:textSize="11sp" />
            <TextView android:id="@+id/cal_row_5_btn" android:layout_width="44dp" android:layout_height="21dp" android:layout_marginStart="6dp" android:background="@drawable/hagom_widget_task_btn_bg" android:gravity="center" android:text="체크" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/cal_row_6" android:layout_width="match_parent" android:layout_height="26dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/cal_row_6_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="" android:textColor="#1F2937" android:textSize="11sp" />
            <TextView android:id="@+id/cal_row_6_btn" android:layout_width="44dp" android:layout_height="21dp" android:layout_marginStart="6dp" android:background="@drawable/hagom_widget_task_btn_bg" android:gravity="center" android:text="체크" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
