<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cell_root"
    android:layout_width="0dp"
    android:layout_height="25dp"
    android:layout_weight="1"
    android:layout_marginHorizontal="1dp"
    android:background="@drawable/hagom_widget_bg">

    <!-- 날짜 숫자 (중앙) -->
    <TextView
        android:id="@+id/day_num"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="1"
        android:textColor="#1F2937"
        android:textSize="10.5sp" />

    <!-- 우측 상단 할일 핀 (동그라미 닷) -->
    <ImageView
        android:id="@+id/task_dot"
        android:layout_width="4.5dp"
        android:layout_height="4.5dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="2.5dp"
        android:layout_marginEnd="2.5dp"
        android:visibility="gone"
        android:background="@drawable/hagom_widget_btn_bg"
        android:contentDescription="할일 핀" />

    <!-- 하단 복약/습관 캡슐 바 (가로 바) -->
    <LinearLayout
        android:id="@+id/bar_bottom"
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="3dp"
        android:layout_marginBottom="2dp"
        android:visibility="gone"
        android:background="#EF4444"
        android:orientation="horizontal" />

</FrameLayout>
