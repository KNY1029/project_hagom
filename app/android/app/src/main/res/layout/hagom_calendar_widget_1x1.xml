<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_calendar_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hagom_widget_bg"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="8dp">

    <!-- 상단 라벨 -->
    <TextView
        android:id="@+id/widget_calendar_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="할일"
        android:textColor="#7B61A8"
        android:textSize="11.5sp"
        android:textStyle="bold" />

    <!-- 중앙 대형 달성 현황 수치 (예: 1/2) -->
    <TextView
        android:id="@+id/widget_calendar_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="1/2"
        android:textColor="#1F2937"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- 하단 상태 라벨 (진행 중 / 완료) -->
    <TextView
        android:id="@+id/widget_calendar_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="진행 중"
        android:textColor="#6B7280"
        android:textSize="10.5sp" />

</LinearLayout>
