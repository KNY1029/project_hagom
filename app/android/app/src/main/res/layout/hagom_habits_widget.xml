<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_habits_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hagom_widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_habits_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/hagom_widget_done_bg"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="2dp"
                    android:text="오늘의 습관"
                    android:textColor="#044E36"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_habits_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text=""
                    android:textColor="#6B7280"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_habits_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#1F2937"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_habits_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#4B5568"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_habits_btn"
            android:layout_width="72dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/hagom_widget_habit_btn_bg"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_habits_btn_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="실천"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/habits_expanded_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="6dp"
            android:background="#E5E7EB" />

        <LinearLayout
            android:id="@+id/habits_row_1"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/habits_row_1_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#1F2937"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/habits_row_1_btn"
                android:layout_width="54dp"
                android:layout_height="24dp"
                android:background="@drawable/hagom_widget_habit_btn_bg"
                android:gravity="center"
                android:text="실천"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/habits_row_2"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/habits_row_2_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#1F2937"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/habits_row_2_btn"
                android:layout_width="54dp"
                android:layout_height="24dp"
                android:background="@drawable/hagom_widget_habit_btn_bg"
                android:gravity="center"
                android:text="실천"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/habits_row_3"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/habits_row_3_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#1F2937"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/habits_row_3_btn"
                android:layout_width="54dp"
                android:layout_height="24dp"
                android:background="@drawable/hagom_widget_habit_btn_bg"
                android:gravity="center"
                android:text="실천"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/habits_row_4"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/habits_row_4_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#1F2937"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/habits_row_4_btn"
                android:layout_width="54dp"
                android:layout_height="24dp"
                android:background="@drawable/hagom_widget_habit_btn_bg"
                android:gravity="center"
                android:text="실천"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
