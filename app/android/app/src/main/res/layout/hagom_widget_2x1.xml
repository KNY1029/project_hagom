<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hagom_widget_bg"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical">

    <!-- 좌측 정보 영역 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <!-- 상단 태그 및 회차 정보 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/hagom_widget_tag_bg"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="다음 복약"
                android:textColor="#7B61A8"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="2/3 완료"
                android:textColor="#6B7280"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- 약 이름 -->
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Focusin 10mg"
            android:textColor="#1F2937"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- 복용법 / 예정 시각 -->
        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="오후 12:30 · 식후 30분 복용"
            android:textColor="#4B5568"
            android:textSize="11sp" />

        <!-- 처방약 안내 문구 -->
        <TextView
            android:id="@+id/widget_extra"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="처방약 (시간 엄수)"
            android:textColor="#8B5E3C"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 우측 1-Tap 대형 버튼 -->
    <LinearLayout
        android:id="@+id/widget_btn"
        android:layout_width="72dp"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:background="@drawable/hagom_widget_btn_bg"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="6dp">

        <TextView
            android:id="@+id/widget_btn_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="복용"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="1-Tap"
            android:textColor="#FFFFFF"
            android:alpha="0.85"
            android:textSize="9.5sp" />
    </LinearLayout>

</LinearLayout>
