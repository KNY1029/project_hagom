<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E6F8F0" />
            <stroke android:width="1.6dp" android:color="#00000000" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <item android:gravity="bottom" android:bottom="2dp" android:left="3dp" android:right="3dp">
        <shape android:shape="rectangle">
            <size android:height="4.5dp" />
            <solid android:color="#EF4444" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
