<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 연초록 파스텔 올클리어 바탕 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E6F8F0" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <!-- 우측 상단 딥 포레스트 그린 원형 핀 -->
    <item android:gravity="top|end" android:top="2.5dp" android:right="2.5dp">
        <shape android:shape="oval">
            <size android:width="4.5dp" android:height="4.5dp" />
            <solid android:color="#044E36" />
        </shape>
    </item>
</layer-list>
