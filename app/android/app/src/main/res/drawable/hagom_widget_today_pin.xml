<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <stroke android:width="1.2dp" android:color="#807B61A8" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <item android:gravity="top|end" android:top="2.5dp" android:right="2.5dp">
        <shape android:shape="oval">
            <size android:width="4.5dp" android:height="4.5dp" />
            <solid android:color="#7B61A8" />
        </shape>
    </item>
</layer-list>
